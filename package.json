{
  "name": "mcp-file-server",
  "version": "1.0.0",
  "private": true,
  "description": "MCP file-server connector: sandboxed workspace, 8 tools, planner/builder roles, Streamable HTTP.",
  "main": "dist/server.js",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^4.21.2",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

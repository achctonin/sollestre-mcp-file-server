# Copy to .env and edit. Run everything from the repo root (relative paths resolve from the cwd).
PORT=3000
# Sandbox root. Created on startup. Every tool path is resolved inside this folder.
WORKSPACE_ROOT=./workspace
# Optional: where logs/calls.jsonl is written (default ./logs)
# LOG_DIR=./logs
# Optional: use a Cloudflare *named* tunnel (stable URL). Leave empty for a quick tunnel.
# CLOUDFLARE_TUNNEL_NAME=
# Optional git identity used by git_commit when no global git config exists
# GIT_AUTHOR_NAME=MCP Agent
# GIT_AUTHOR_EMAIL=agent@localhost
